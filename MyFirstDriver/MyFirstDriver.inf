;
; MyFirstDriver.inf
;
; Primitive (software-only, non-PnP) driver package: installs MyFirstDriver.sys as a
; demand-start kernel service. Run from the driver store (DIRID 13).
;

[Version]
Signature="$WINDOWS NT$"
Class=System
ClassGuid={4d36e97d-e325-11ce-bfc1-08002be10318}
Provider=%ManufacturerName%
DriverVer=
CatalogFile=MyFirstDriver.cat
PnpLockdown=1

[DestinationDirs]
DefaultDestDir = 13

[SourceDisksNames]
1 = %DiskName%,,,""

[SourceDisksFiles]
MyFirstDriver.sys = 1,,

[DefaultInstall.NT$ARCH$]
CopyFiles = MyFirstDriver_CopyFiles

[DefaultInstall.NT$ARCH$.Services]
AddService = %ServiceName%,,MyFirstDriver_Service

[DefaultUninstall.NT$ARCH$]
LegacyUninstall = 1

[DefaultUninstall.NT$ARCH$.Services]
DelService = %ServiceName%,0x200 ; SPSVCINST_STOPSERVICE

[MyFirstDriver_CopyFiles]
MyFirstDriver.sys

[MyFirstDriver_Service]
DisplayName    = %ServiceDisplayName%
ServiceType    = 1 ; SERVICE_KERNEL_DRIVER
StartType      = 3 ; SERVICE_DEMAND_START
ErrorControl   = 1 ; SERVICE_ERROR_NORMAL
ServiceBinary  = %13%\MyFirstDriver.sys

[Strings]
ManufacturerName="KM-UM Communication Sample"
DiskName="MyFirstDriver Source Disk"
ServiceName="MyFirstDriver"
ServiceDisplayName="MyFirstDriver KM-UM Echo Driver"
